# Required by the song-writing and GitHub-intelligence pipeline.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Enables the Greptile indexed-code analysis (architecture, entrypoints, tests,
# dependencies, hotspots, and source locations). Set GREPTILE_ENABLE=0 to use
# the local fallback instead. GREPTILE_GENIUS=1 requests its deeper query mode.
GREPTILE_API_KEY=
GREPTILE_ENABLE=1
GREPTILE_GENIUS=0

# Broadcasts pipeline logs and the released mp3/video URLs to every chat that has
# messaged the bot. Leave empty to disable notifications entirely.
TELEGRAM_BOT_TOKEN=
# Base of the public site, used to build absolute URLs in those notifications.
DROPTABLE_BASE_URL=https://droptable-127827893419.us-central1.run.app

# Video rendering: your own GCP project for Veo 2 footage (required by that
# backend), your own `modal deploy` URL for the CogVideoX fallback backend, and
# the optional music-to-video skill scripts dir (falls back to built-ins).
GOOGLE_CLOUD_PROJECT=
COGVIDEOX_ENDPOINT=
# MUSIC_TO_VIDEO_SCRIPTS=/path/to/skills/music-to-video/scripts

# Optional: absolute path to the Python interpreter used by the Next.js API route.
# PYTHON=/path/to/droptable/.venv/bin/python
