# Required by the song-writing and GitHub-intelligence pipeline.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Optional: enables the Greptile query path instead of local GitHub intelligence.
GREPTILE_API_KEY=
GREPTILE_ENABLE=

# Optional: absolute path to the Python interpreter used by the Next.js API route.
# PYTHON=/path/to/droptable/.venv/bin/python
