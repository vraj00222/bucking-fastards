# Required by the song-writing and GitHub-intelligence pipeline.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Enables the Greptile indexed-code analysis (architecture, entrypoints, tests,
# dependencies, hotspots, and source locations). Set GREPTILE_ENABLE=0 to use
# the local fallback instead. GREPTILE_GENIUS=1 requests its deeper query mode.
GREPTILE_API_KEY=
GREPTILE_ENABLE=1
GREPTILE_GENIUS=0

# Optional: absolute path to the Python interpreter used by the Next.js API route.
# PYTHON=/path/to/droptable/.venv/bin/python
